.venv/
__pycache__/
*.pyc
.env
.env.*
*.key
*.pem
credentials*.json
.DS_Store
.claude/settings.local.json
spikes/out/

# runtime job state; the committed demo under data/demo/ is the exception
data/*
!data/demo/
!data/demo/**
# The manual cache baked into the container image. Only the hand-checked LINKS listed
# below (URL + page numbers, no manual text) are source and travel with the repo.
# Everything else in this directory is ignored on purpose: the page text fetched at
# runtime (_pages/), the PDF while it is read (_pdf/), and any other lookup's entry.
# Adding a model with tools/bake_manual_cache.py means adding a line here too.
!data/manuals/
data/manuals/*
!data/manuals/index.json
!data/manuals/westinghouse-epx3030.json
!data/manuals/ryobi-ry31012.json
!data/manuals/ryobi-ry40lb01k.json

# setuptools wheel-build scratch (tools/ and the Dockerfile both build out-of-tree)
build/

# Build metadata regenerated by `pip install -e .` — not source. It was tracked until
# 2026-09-11, which meant every editable install produced a spurious diff in a public repo.
src/*.egg-info/

# Model weights are fetched, not committed (tools/fetch_models.sh checks the checksum).
models/*.onnx
models/*.part
